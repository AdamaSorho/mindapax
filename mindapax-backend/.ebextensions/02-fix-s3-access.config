# .ebextensions/02-fix-s3-access.config
# Simpler configuration focusing only on the S3 access issue

option_settings:
  # Completely disable managed actions
  aws:elasticbeanstalk:managedactions:
    ManagedActionsEnabled: false
  
  # Disable platform updates
  aws:elasticbeanstalk:managedactions:platformupdate:
    UpdateLevel: none
    InstanceRefreshEnabled: false

commands:
  # Create the problematic file locally to prevent download attempts
  01_create_patch_extension_dummy:
    command: |
      # Create the directory structure
      sudo mkdir -p /tmp/eb_patching_resources
      
      # Create the dummy patch extension file
      cat << 'EOF' > /tmp/eb_patching_resources/instance_patch_extension.linux
      #!/bin/bash
      # Dummy patch extension to prevent S3 access errors
      echo "Platform patching disabled via ebextensions"
      exit 0
      EOF
      
      chmod +x /tmp/eb_patching_resources/instance_patch_extension.linux
      
      # Also create it in the expected EB location
      sudo mkdir -p /opt/elasticbeanstalk/lib/ruby/lib/ruby/gems/2.6.0/gems
      sudo mkdir -p /var/app/staging/eb_patching_resources
      sudo cp /tmp/eb_patching_resources/instance_patch_extension.linux /var/app/staging/eb_patching_resources/
      
    ignoreErrors: true

  # Disable SSM agent to prevent automatic patching attempts
  02_disable_ssm_agent:
    command: |
      # Stop and disable SSM agent
      sudo systemctl stop amazon-ssm-agent || true
      sudo systemctl disable amazon-ssm-agent || true
      
      # Create a dummy SSM agent script
      sudo mkdir -p /usr/bin
      sudo mv /usr/bin/amazon-ssm-agent /usr/bin/amazon-ssm-agent.backup || true
      
      cat << 'EOF' > /usr/bin/amazon-ssm-agent
      #!/bin/bash
      echo "SSM Agent disabled via ebextensions"
      exit 0
      EOF
      
      sudo chmod +x /usr/bin/amazon-ssm-agent
      
    ignoreErrors: true

files:
  # Override the EB agent configuration
  "/etc/elasticbeanstalk/.aws-eb-system-config":
    mode: "000644"
    owner: root
    group: root
    content: |
      {
        "managed_actions_enabled": false,
        "platform_updates_enabled": false,
        "instance_patching_enabled": false
      }

  # Create a custom hook to prevent S3 downloads
  "/opt/elasticbeanstalk/hooks/appdeploy/pre/99_prevent_s3_downloads.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      # Prevent problematic S3 downloads
      
      # Create dummy files for any resources that might be requested
      mkdir -p /tmp/eb_patching_resources
      touch /tmp/eb_patching_resources/instance_patch_extension.linux
      chmod +x /tmp/eb_patching_resources/instance_patch_extension.linux
      
      # Set environment variable to skip platform updates
      export EB_SKIP_PLATFORM_UPDATES=true
      
      echo "S3 download prevention hook executed"