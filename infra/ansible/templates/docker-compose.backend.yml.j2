services:
  db:
    image: postgres:15
    restart: always
    env_file:
      - {{ docker_env_file }}
    environment:
      POSTGRES_DB: {{ db_name }}
      POSTGRES_USER: {{ db_user }}
      POSTGRES_PASSWORD: {{ db_password }}
    volumes:
      - db_data:/var/lib/postgresql/data
    networks:
      - mindapax_net

  backend:
    build:
      context: {{ docker_backend_context }}
      dockerfile: Dockerfile
    restart: always
    env_file:
      - {{ docker_env_file }}
    environment:
      POSTGRES_HOST: db
      POSTGRES_PORT: "5432"
    depends_on:
      - db
    ports:
      - "8080:8080"
    networks:
      - mindapax_net
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

volumes:
  db_data:

networks:
  mindapax_net:
    driver: bridge
