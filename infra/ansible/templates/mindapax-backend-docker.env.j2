OPENAI_API_KEY={{ openai_api_key }}
OPENAI_ORGANIZATION_ID={{ openai_org_id }}

ZOOM_SDK_KEY={{ zoom_sdk_key }}
ZOOM_SDK_SECRET={{ zoom_sdk_secret }}
ZOOM_API_ACCOUNT_ID={{ zoom_api_account_id }}
ZOOM_API_CLIENT_ID={{ zoom_api_client_id }}
ZOOM_API_CLIENT_SECRET={{ zoom_api_client_secret }}

CINETPAY_API_KEY={{ cinetpay_api_key }}
CINETPAY_SITE_ID={{ cinetpay_site_id }}
CINETPAY_BASE_URL={{ cinetpay_base_url }}
CINETPAY_NOTIFY_URL={{ cinetpay_notify_url }}
CINETPAY_RETURN_URL={{ cinetpay_return_url }}

{% for key, value in extra_env.items() %}
{{ key }}={{ value }}
{% endfor %}
