# Copy this file to backend.secrets.yml and encrypt it with Ansible Vault:
#   cp backend.secrets.yml.example backend.secrets.yml
#   ansible-vault encrypt backend.secrets.yml
#
# Required secrets
vault_db_password: "change-me-db-password"
vault_jwt_secret: "change-me-jwt-secret"

# Optional integrations
vault_aws_access_key_id: ""
vault_aws_secret_access_key: ""
vault_aws_s3_bucket: ""
vault_openai_api_key: ""
vault_openai_org_id: ""
vault_zoom_sdk_key: ""
vault_zoom_sdk_secret: ""
vault_zoom_api_account_id: ""
vault_zoom_api_client_id: ""
vault_zoom_api_client_secret: ""
vault_cinetpay_api_key: ""
vault_cinetpay_site_id: ""
vault_cinetpay_base_url: "https://api-checkout.cinetpay.com"
vault_cinetpay_notify_url: ""
vault_cinetpay_return_url: ""
